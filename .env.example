# Local vLLM
API_KEY=EMPTY
BASE_URL=http://127.0.0.1:8001/v1
VLLM_BASE_URL=http://127.0.0.1:8001
LLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct

# Original OpenAI-compatible GPT channel, tried after ALT_GPT.
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1

# Preferred GPT channel. Runtime order: ALT_GPT -> OPENAI -> DEEPSEEK -> ZHIPU.
# Fill these with your alternate GPT-compatible endpoint and key.
ALT_GPT_API_KEY=sk-your-alt-gpt-key-here
ALT_GPT_BASE_URL=https://your-alt-gpt-endpoint/v1
ALT_GPT_5_2_MODEL=gpt-5.2
ALT_GPT_5_5_MODEL=gpt-5.5

# DeepSeek fallback channel, tried after ALT_GPT and OPENAI, before Zhipu.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://your-deepseek-endpoint/v1
DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro

# Zhipu GLM
ZHIPUAI_API_KEY=your-zhipu-key-here
